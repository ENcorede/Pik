#  TETRIS
# ============================================================
def tt_new_piece():
    key = random.choice(list(TT_SHAPES.keys()))
    return {'key': key, 'cells': TT_SHAPES[key], 'x': TT_W//2 - 1, 'y': 0}

def tt_rotate(cells):
    rotated = [(-c, r) for r, c in cells]
    minr = min(r for r, c in rotated); minc = min(c for r, c in rotated)
    return [(r-minr, c-minc) for r, c in rotated]

def tt_fits(board, cells, x, y):
    for r, c in cells:
        nr, nc = y+r, x+c
        if nr < 0 or nr >= TT_H or nc < 0 or nc >= TT_W: return False
        if board[nr][nc] != '.': return False
    return True

def tt_clear_lines(board):
    new_board = [row[:] for row in board if '.' in row]
    cleared = TT_H - len(new_board)
    for _ in range(cleared): new_board.insert(0, ['.']*TT_W)
    return new_board, cleared

def tt_spawn(st):
    piece = tt_new_piece()
    if not tt_fits(st['board'], piece['cells'], piece['x'], piece['y']):
        st['status'] = 'lost'
        return
    st['piece'] = piece

def tt_lock(st):
    p = st['piece']
    for r, c in p['cells']:
        nr, nc = p['y']+r, p['x']+c
        if 0 <= nr < TT_H and 0 <= nc < TT_W:
            st['board'][nr][nc] = p['key']
    st['board'], cleared = tt_clear_lines(st['board'])
    if cleared:
        st['score'] += [0, 100, 300, 500, 800][cleared]
        st['lines'] += cleared
    tt_spawn(st)

def tt_init():
    st = {'board': [['.']*TT_W for _ in range(TT_H)],
          'score': 0, 'lines': 0, 'status': 'playing', 'piece': None}
    tt_spawn(st)
    return st

def tt_encode(st):
    grid = [row[:] for row in st['board']]
    if st['piece'] and st['status'] == 'playing':
        p = st['piece']
        for r, c in p['cells']:
            nr, nc = p['y']+r, p['x']+c
            if 0 <= nr < TT_H and 0 <= nc < TT_W and grid[nr][nc] == '.':
                grid[nr][nc] = p['key']
    return ''.join(''.join(row) for row in grid)

def tt_render(st):
    text = ('Игра окончена. Счёт: ' + str(st['score'])) if st['status'] == 'lost' else \
           'Управляйте кнопками. Собирайте линии!'
    controls = [
        btn('⬅️', 'tt:left'), btn('↻', 'tt:rotate'),
        btn('⬇️', 'tt:drop'),  btn('➡️', 'tt:right'),
    ] if st['status'] == 'playing' else []
    return {
        'game': 'tetris', 'width': TT_W, 'height': TT_H, 'cell': 14,
        'board': tt_encode(st), 'status': st['status'],
        'title': '🧱 Тетрис', 'sub': f'{TT_W}×{TT_H}',
        'scorebar': [{'label': 'Счёт', 'value': st['score']},
                     {'label': 'Линии', 'value': st['lines']}],
        'text': text,
        'controls': True, 'controls_grid': controls,
        'buttons': [
            btn('🔄 Новая игра', 'tt:restart', True, True),
            btn('← В меню', 'menu', wide=True),
        ]
    }

def tt_handle(uid, data):
    if uid not in GAME_STATES or GAME_STATES[uid]['game'] != 'tetris':
        GAME_STATES[uid] = {'game': 'tetris', 'state': tt_init()}
        bump(uid, 'tetris_games', 1)
    st = GAME_STATES[uid]['state']
    if data == 'tt:restart':
        GAME_STATES[uid]['state'] = tt_init()
        bump(uid, 'tetris_games', 1)
        return tt_render(GAME_STATES[uid]['state'])
    if st['status'] != 'playing':
        return tt_render(st)
    p = st['piece']
    if data == 'tt:left':
        if tt_fits(st['board'], p['cells'], p['x']-1, p['y']): p['x'] -= 1
    elif data == 'tt:right':
        if tt_fits(st['board'], p['cells'], p['x']+1, p['y']): p['x'] += 1
    elif data == 'tt:rotate':
        new_cells = tt_rotate(p['cells'])
        if tt_fits(st['board'], new_cells, p['x'], p['y']):
            p['cells'] = new_cells
    elif data == 'tt:drop':
        if tt_fits(st['board'], p['cells'], p['x'], p['y']+1):
            p['y'] += 1
        else:
            tt_lock(st)
            if st['status'] == 'lost':
                bump(uid, 'tetris_best', st['score'], 'max')
                bump(uid, 'tetris_lines', st['lines'])
    return tt_render(st)

