async def handle_text(m):
    u = m.get('from', {}); uid = u.get('id')
    text = (m.get('text') or '').strip()
    if not uid or not text: return
    ensure_user(u)
    chat_id = m['chat']['id']

    if text.startswith('/start') or text.startswith('/play'):
        parts = text.split(maxsplit=1)
        if len(parts) > 1:
            game = parts[1].strip().lower()
            if game in GAME_NAMES:
                await send_game_widget(chat_id, chat_data=f'game:{game}')
            else:
                await send_message(chat_id,
                    f"Игра не найдена. Доступны: {', '.join(GAME_NAMES)}")
        else:
            await send_game_widget(chat_id, chat_data='menu')
        return

    if text.startswith('/reit'):
        parts = text.split(maxsplit=1)
        game = parts[1].strip().lower() if len(parts) > 1 else None
        if game and game not in GAME_NAMES:
            await send_message(chat_id, "Нет такой игры. Доступно: "
                + ', '.join(GAME_NAMES)); return
        await send_message(chat_id, build_rating(game))
        return

    if text.startswith('/stats'):
        if uid not in ADMINS:
            await send_message(chat_id, "Нет доступа."); return
        await send_message(chat_id, build_stats())
        return

    if text.startswith('/cancel'):
        await send_message(chat_id, "Ок.")
        return

