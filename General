def ms_handle(uid, data):
    if uid not in GAME_STATES or GAME_STATES[uid]['game'] != 'minesweeper':
        GAME_STATES[uid] = {'game': 'minesweeper', 'state': ms_init()}
        bump(uid, 'minesweeper_games', 1)
    st = GAME_STATES[uid]['state']
    if data == 'ms:restart':
        GAME_STATES[uid]['state'] = ms_init()
        bump(uid, 'minesweeper_games', 1)
    elif data.startswith('ms:r:'):
        _, _, r, c = data.split(':'); r, c = int(r), int(c)
        if st['flagged'][r][c]:
            st['flagged'][r][c] = False
        elif st['revealed'][r][c]:
            st['flagged'][r][c] = True
        else:
            ms_reveal(st, r, c)
        if st['status'] == 'won': bump(uid, 'minesweeper_wins', 1)
    return ms_render(GAME_STATES[uid]['state'])

# ============================================================
#  SNAKE
# ============================================================
def sn_spawn_food(snake):
    occ = set(snake)
    free = [(r, c) for r in range(SN_SIZE) for c in range(SN_SIZE) if (r, c) not in occ]
    return random.choice(free) if free else (0, 0)

def sn_init():
    cx = cy = SN_SIZE // 2
    snake = [(cx, cy), (cx, cy-1), (cx, cy-2)]
    return {'snake': snake, 'dir': 'R', 'food': sn_spawn_food(snake),
            'score': 0, 'status': 'playing'}

def sn_encode(st):
    grid = [['.']*SN_SIZE for _ in range(SN_SIZE)]
    for i, (r, c) in enumerate(st['snake']):
        if 0 <= r < SN_SIZE and 0 <= c < SN_SIZE:
            grid[r][c] = 'H' if i == 0 else 'S'
    fr, fc = st['food']; grid[fr][fc] = 'F'
    return ''.join(''.join(row) for row in grid)

def sn_step(st, d):
    if st['status'] != 'playing': return
    rev = {'U': 'D', 'D': 'U', 'L': 'R', 'R': 'L'}
    if rev.get(st['dir']) == d: return
    dr, dc = {'U': (-1, 0), 'D': (1, 0), 'L': (0, -1), 'R': (0, 1)}[d]
    hr, hc = st['snake'][0]; nr, nc = hr+dr, hc+dc
    if not (0 <= nr < SN_SIZE and 0 <= nc < SN_SIZE): st['status'] = 'lost'; return
    if (nr, nc) in st['snake'][:-1]: st['status'] = 'lost'; return
    st['snake'].insert(0, (nr, nc)); st['dir'] = d
    if (nr, nc) == st['food']:
        st['score'] += 1; st['food'] = sn_spawn_food(st['snake'])
    else:
        st['snake'].pop()

def sn_render(st):
