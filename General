def ca_payout(reels, bet):
    if reels[0] == reels[1] == reels[2]:
        return bet * SLOT_PAYOUTS.get(reels[0], 3)
    if reels[0] == reels[1] or reels[1] == reels[2] or reels[0] == reels[2]:
        return bet * 2
    return 0

def ca_render(st, uid):
    coins = get_coins(uid)
    if st['last'] is None:
        text = f'Ставка {SLOT_BET} 🪙. Соберите 3 одинаковых символа!'
    elif st['last'] > 0:
        text = f'🎉 Выигрыш: +{fmt(st["last"])} 🪙'
    else:
        text = f'😢 Не повезло, –{SLOT_BET} 🪙'
    if coins < SLOT_BET:
        text += '\n\n⚠️ Монеты закончились. Нажмите «Пополнить» (бесплатно).'
    return {
        'game': 'casino777', 'reels': st.get('reels', ['❓', '❓', '❓']),
        'title': '🎰 777 Казино', 'sub': f'Ставка {SLOT_BET} 🪙',
        'scorebar': [{'label': 'Монеты', 'value': fmt(coins)},
                     {'label': 'Ставка', 'value': SLOT_BET}],
        'text': text,
        'buttons': [
            btn('🎰 Крутить', 'ca:spin', True, True) if coins >= SLOT_BET else
                btn('💎 Пополнить (+1000)', 'ca:refill', True, True),
            btn('← В меню', 'menu', wide=True),
        ]
    }

def ca_handle(uid, data):
    if uid not in GAME_STATES or GAME_STATES[uid]['game'] != 'casino777':
        GAME_STATES[uid] = {'game': 'casino777',
                            'state': {'reels': ['❓', '❓', '❓'], 'last': None}}
    st = GAME_STATES[uid]['state']
    if data == 'ca:refill':
        set_coins(uid, get_coins(uid) + 1000)
    elif data == 'ca:spin':
        coins = get_coins(uid)
        if coins < SLOT_BET:
            return ca_render(st, uid)
        set_coins(uid, coins - SLOT_BET)
        bump(uid, 'casino_games', 1)
        reels = [random.choice(SLOT_SYMBOLS) for _ in range(3)]
        payout = ca_payout(reels, SLOT_BET)
        if payout > 0:
            set_coins(uid, get_coins(uid) + payout)
            bump(uid, 'casino_wins', 1)
        st['reels'] = reels; st['last'] = payout
    return ca_render(st, uid)

