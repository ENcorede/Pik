                out = start_game(uid, target[5:])
            else:
                out = menu_view(uid)
        elif data == 'menu':
            GAME_STATES.pop(uid, None)
            out = menu_view(uid)
        elif data.startswith('start:'):
            out = start_game(uid, data.split(':', 1)[1])
        elif data.startswith('ms:'):
            out = ms_handle(uid, data)
        elif data.startswith('sn:'):
            out = sn_handle(uid, data)
        elif data.startswith('fi:'):
            out = fi_handle(uid, data)
        elif data.startswith('ca:'):
            out = ca_handle(uid, data)
        elif data.startswith('tt:'):
            out = tt_handle(uid, data)
        elif data == 'show:rating':
            out = {'view': 'rating', 'title': '📊 Рейтинг',
                   'sub': 'Выберите игру, чтобы открыть таблицу в чате',
                   'text': 'Отправьте /reit — рейтинг всех игр,\n'
                           '/reit snake, /reit minesweeper, /reit fishing,\n'
                           '/reit casino777, /reit tetris — по игре.',
                   'buttons': [btn('← В меню', 'menu', wide=True)]}
        else:
            out = menu_view(uid)
    except Exception as e:
        logging.exception("widget error")
        out = {'title': 'Ошибка', 'sub': str(e), 'buttons': [btn('← В меню', 'menu', True, True)]}
    await answer_widget(qid, out)

