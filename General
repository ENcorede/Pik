#  Polling
# ============================================================
async def poll():
    global offset
    while True:
        try:
            updates = await api('getUpdates', {
                'offset': offset, 'timeout': 25,
                'allowed_updates': ['message', 'widget_query', 'shared_widget_query']
            })
            for up in updates:
                offset = up['update_id'] + 1
                if 'message' in up: await handle_text(up['message'])
                elif 'widget_query' in up: await widget_action(up['widget_query'])
                elif 'shared_widget_query' in up: await widget_action(up['shared_widget_query'])
        except asyncio.CancelledError:
            raise
        except Exception:
            logging.exception("Polling error")
            await asyncio.sleep(2)

async def main():
    global session
    init_db()
    session = aiohttp.ClientSession(timeout=aiohttp.ClientTimeout(total=35))
    try:
        me = await api('getMe')
        logging.info("PikGame started: @%s", me.get('username'))
        await poll()
    finally:
        await session.close()

if __name__ == '__main__':
    asyncio.run(main())
