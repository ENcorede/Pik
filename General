# ============================================================
#  MINESWEEPER
# ============================================================
def ms_init():
    board = [[0]*MS_SIZE for _ in range(MS_SIZE)]
    cells = [(r, c) for r in range(MS_SIZE) for c in range(MS_SIZE)]
    for r, c in random.sample(cells, MS_MINES):
        board[r][c] = -1
    for r, c in [(r, c) for r in range(MS_SIZE) for c in range(MS_SIZE) if board[r][c] == -1]:
        for dr in (-1, 0, 1):
            for dc in (-1, 0, 1):
                nr, nc = r+dr, c+dc
                if 0 <= nr < MS_SIZE and 0 <= nc < MS_SIZE and board[nr][nc] != -1:
                    board[nr][nc] += 1
    return {'board': board,
            'revealed': [[False]*MS_SIZE for _ in range(MS_SIZE)],
            'flagged': [[False]*MS_SIZE for _ in range(MS_SIZE)],
            'status': 'playing'}

def ms_encode(st):
    out = []
    for r in range(MS_SIZE):
        for c in range(MS_SIZE):
            if st['status'] == 'lost' and st['board'][r][c] == -1 and not st['flagged'][r][c]:
                out.append('X')
            elif st['flagged'][r][c]:
                out.append('F')
            elif st['revealed'][r][c]:
                v = st['board'][r][c]; out.append('.' if v == 0 else str(v))
            else:
                out.append('H')
    return ''.join(out)

def ms_reveal(st, r, c):
    if st['status'] != 'playing': return
    if not (0 <= r < MS_SIZE and 0 <= c < MS_SIZE): return
    if st['revealed'][r][c] or st['flagged'][r][c]: return
    if st['board'][r][c] == -1:
        st['revealed'][r][c] = True; st['status'] = 'lost'; return
    stack = [(r, c)]
    while stack:
        r, c = stack.pop()
        if not (0 <= r < MS_SIZE and 0 <= c < MS_SIZE): continue
        if st['revealed'][r][c] or st['flagged'][r][c]: continue
        if st['board'][r][c] == -1: continue
        st['revealed'][r][c] = True
        if st['board'][r][c] == 0:
            for dr in (-1, 0, 1):
                for dc in (-1, 0, 1):
                    if dr or dc: stack.append((r+dr, c+dc))
    if all(st['revealed'][r][c] for r in range(MS_SIZE) for c in range(MS_SIZE)
           if st['board'][r][c] != -1):
        st['status'] = 'won'

def ms_render(st):
    text = {'won': '🏆 Поле очищено!', 'lost': '💥 Мина. Попробуйте снова.',
            'playing': 'Нажимайте на клетки. 🚩 ставится повторным тапом.'}[st['status']]
    return {
        'game': 'minesweeper', 'size': MS_SIZE, 'cell': 30,
        'board': ms_encode(st), 'status': st['status'],
        'title': '💣 Сапёр', 'sub': f'{MS_SIZE}×{MS_SIZE} · {MS_MINES} мин',
        'scorebar': [{'label': 'Статус',
                      'value': {'playing': 'В игре', 'won': 'Победа', 'lost': 'Проигрыш'}[st['status']]}],
        'text': text,
