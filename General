# ============================================================
#  DB
# ============================================================
def db():
    c = sqlite3.connect(DB_FILE)
    c.row_factory = sqlite3.Row
    return c

def now_iso():
    return datetime.now(timezone.utc).isoformat()

def fmt(n):
    return f"{int(n):,}".replace(',', ' ')

def init_db():
    with db() as c:
        c.executescript("""
        CREATE TABLE IF NOT EXISTS users(
            user_id INTEGER PRIMARY KEY, username TEXT, first_name TEXT,
            casino_coins INTEGER NOT NULL DEFAULT 1000, created_at TEXT NOT NULL);
        CREATE TABLE IF NOT EXISTS game_stats(
            user_id INTEGER PRIMARY KEY,
            minesweeper_games INTEGER NOT NULL DEFAULT 0,
            minesweeper_wins  INTEGER NOT NULL DEFAULT 0,
            snake_games   INTEGER NOT NULL DEFAULT 0,
            snake_best    INTEGER NOT NULL DEFAULT 0,
            fishing_games INTEGER NOT NULL DEFAULT 0,
            fishing_score INTEGER NOT NULL DEFAULT 0,
            casino_games  INTEGER NOT NULL DEFAULT 0,
            casino_wins   INTEGER NOT NULL DEFAULT 0,
            tetris_games  INTEGER NOT NULL DEFAULT 0,
            tetris_best   INTEGER NOT NULL DEFAULT 0,
            tetris_lines  INTEGER NOT NULL DEFAULT 0);
        """)
        c.commit()

def ensure_user(u):
    with db() as c:
        c.execute("""INSERT INTO users(user_id,username,first_name,created_at) VALUES(?,?,?,?)
        ON CONFLICT(user_id) DO UPDATE SET username=excluded.username, first_name=excluded.first_name""",
            (u['id'], u.get('username'), u.get('first_name'), now_iso()))
        c.execute("INSERT OR IGNORE INTO game_stats(user_id) VALUES(?)", (u['id'],))
        c.commit()

def bump(uid, field, value, mode='add'):
    ensure_user({'id': uid})
    with db() as c:
        if mode == 'add':
            c.execute(f"UPDATE game_stats SET {field}={field}+? WHERE user_id=?", (value, uid))
        elif mode == 'max':
            c.execute(f"UPDATE game_stats SET {field}=MAX({field},?) WHERE user_id=?", (value, uid))
        c.commit()

def get_coins(uid):
    with db() as c:
        r = c.execute("SELECT casino_coins FROM users WHERE user_id=?", (uid,)).fetchone()
        return int(r['casino_coins']) if r else SLOT_START

def set_coins(uid, v):
    with db() as c:
        c.execute("UPDATE users SET casino_coins=? WHERE user_id=?", (v, uid))
        c.commit()

