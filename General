async def api(method, data=None):
    async with session.post(f"{API}/{method}", json=data or {}) as r:
        obj = await r.json(content_type=None)
        if not obj.get('ok'):
            raise RuntimeError(f"{method}: {obj.get('description')}")
        return obj.get('result')

async def send_message(chat_id, text, **kw):
    data = {'chat_id': chat_id, 'text': text, 'parse_mode': 'HTML'}
    data.update(kw)
    return await api('sendMessage', data)

async def answer_widget(qid, payload):
    if isinstance(payload, dict):
        payload = json.dumps(payload, ensure_ascii=False, separators=(',', ':'))
    try:
        await api('answerWidgetQuery', {'widget_query_id': qid, 'data': payload[:1000]})
    except Exception:
        logging.exception("answerWidgetQuery failed")

async def send_game_widget(chat_id, chat_data='menu'):
